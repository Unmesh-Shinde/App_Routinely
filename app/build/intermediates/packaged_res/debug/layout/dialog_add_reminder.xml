<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp">

        <!-- ── Category ── -->
        <TextView
            style="@style/LabelText"
            android:text="Category"/>

        <Spinner
            android:id="@+id/spinnerType"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_field"/>

        <!-- ── Title ── -->
        <TextView
            style="@style/LabelText"
            android:layout_marginTop="18dp"
            android:text="Title"/>

        <EditText
            android:id="@+id/etTitle"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:hint="Enter reminder title"
            android:inputType="textCapSentences"
            android:background="@drawable/bg_field"
            android:paddingHorizontal="12dp"/>

        <!-- ── Mode ── -->
        <TextView
            style="@style/LabelText"
            android:layout_marginTop="18dp"
            android:text="Reminder Mode"/>

        <RadioGroup
            android:id="@+id/rgMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <RadioButton
                android:id="@+id/rbFixedTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Fixed Time"
                android:checked="true"
                android:buttonTint="@color/primary"/>

            <RadioButton
                android:id="@+id/rbInterval"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Interval"
                android:buttonTint="@color/primary"/>
        </RadioGroup>

        <!-- ── Fixed time section ── -->
        <LinearLayout
            android:id="@+id/llFixed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp">

            <TextView
                android:id="@+id/tvTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="08:00"
                android:textSize="36sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:gravity="center"/>

            <Button
                android:id="@+id/btnPickTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Change"
                android:backgroundTint="@color/primary"
                android:textColor="@android:color/white"/>
        </LinearLayout>

        <!-- ── Interval section ── -->
        <LinearLayout
            android:id="@+id/llInterval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Every"
                android:textColor="@color/textPrimary"
                android:textSize="15sp"/>

            <EditText
                android:id="@+id/etIntervalMin"
                android:layout_width="72dp"
                android:layout_height="50dp"
                android:layout_marginHorizontal="10dp"
                android:text="60"
                android:inputType="number"
                android:gravity="center"
                android:textStyle="bold"
                android:textSize="18sp"
                android:background="@drawable/bg_field"
                android:textColor="@color/primary"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="minutes"
                android:textColor="@color/textPrimary"
                android:textSize="15sp"/>
        </LinearLayout>

        <!-- ── Repeat days ── -->
        <TextView
            style="@style/LabelText"
            android:layout_marginTop="18dp"
            android:text="Repeat On"/>

        <!-- Day toggles (Mon–Sun) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:gravity="center">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="M" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/textSecondary"/>
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/swMon" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:checked="true" android:showText="false"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="T" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/textSecondary"/>
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/swTue" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:checked="true" android:showText="false"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="W" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/textSecondary"/>
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/swWed" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:checked="true" android:showText="false"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="T" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/textSecondary"/>
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/swThu" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:checked="true" android:showText="false"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="F" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/textSecondary"/>
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/swFri" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:checked="true" android:showText="false"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="S" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/primaryLight"
                    android:alpha="0.7"/>
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/swSat" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:checked="true" android:showText="false"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="S" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/primaryLight"
                    android:alpha="0.7"/>
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/swSun" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:checked="true" android:showText="false"/>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>

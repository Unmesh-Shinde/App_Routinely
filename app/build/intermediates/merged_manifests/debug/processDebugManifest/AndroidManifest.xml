<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.dailyroutine.app"
    android:versionCode="2"
    android:versionName="1.1" >

    <uses-sdk
        android:minSdkVersion="26"
        android:targetSdkVersion="35" />

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Health Connect Permissions -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />

    <queries>
        <package android:name="com.google.android.apps.fitness" />
        <package android:name="com.sec.android.app.shealth" />
        <package android:name="com.fitbit.FitbitMobile" />
        <package android:name="com.garmin.android.apps.connectmobile" />
        <package android:name="com.xiaomi.wearable" />
        <package android:name="com.xiaomi.hm.health" />
        <package android:name="com.huami.watch.hmwatchmanager" />
        <package android:name="com.noisefit" />
        <package android:name="com.coveiot.boat" />
        <package android:name="com.huawei.health" />
        <package android:name="com.realme.link" />
        <package android:name="com.google.android.apps.healthdata" />
        <package android:name="com.fossil.wearables.fossil" />
        <package android:name="com.withings.wiscale2" />
        <package android:name="fi.polar.beat" />
        <package android:name="com.stt.android.suunto" />
    </queries>

    <permission
        android:name="com.dailyroutine.app.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature" />

    <uses-permission android:name="com.dailyroutine.app.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" />

    <application
        android:allowBackup="true"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:testOnly="true"
        android:theme="@style/Theme.DailyRoutine" >
        <activity
            android:name="com.dailyroutine.app.MainActivity"
            android:exported="true"
            android:launchMode="singleTop" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Health Connect Intent Filter -->
            <intent-filter>
                <action android:name="androidx.health.connect.client.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.dailyroutine.app.SignupActivity"
            android:exported="false"
            android:theme="@style/Theme.DailyRoutine" />
        <activity
            android:name="com.dailyroutine.app.RemindersActivity"
            android:exported="false"
            android:label="View Reminders" />
        <activity
            android:name="com.dailyroutine.app.DietPlanActivity"
            android:exported="false"
            android:label="Diet Plan" />
        <activity
            android:name="com.dailyroutine.app.WorkoutPlanActivity"
            android:exported="false"
            android:label="Workout Plan" />
        <activity
            android:name="com.dailyroutine.app.WalkingDataActivity"
            android:exported="false"
            android:label="Step Tracker" />
        <activity
            android:name="com.dailyroutine.app.SleepTrackingActivity"
            android:exported="false"
            android:label="Sleep Tracking" />
        <activity
            android:name="com.dailyroutine.app.WeightActivity"
            android:exported="false"
            android:label="Weight Tracking" />
        <activity
            android:name="com.dailyroutine.app.CaloriesActivity"
            android:exported="false"
            android:label="Calories Tracking" />
        <activity
            android:name="com.dailyroutine.app.HabitProgressActivity"
            android:exported="false"
            android:label="Daily Progress" />
        <activity
            android:name="com.dailyroutine.app.ProfileActivity"
            android:exported="false"
            android:label="My Profile" />

        <receiver
            android:name="com.dailyroutine.app.ReminderReceiver"
            android:exported="false" />
        <receiver
            android:name="com.dailyroutine.app.ReminderActionReceiver"
            android:exported="false" />
        <receiver
            android:name="com.dailyroutine.app.BootReceiver"
            android:exported="true" >
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <service
            android:name="androidx.health.platform.client.impl.sdkservice.HealthDataSdkService"
            android:enabled="true"
            android:exported="true" >
            <intent-filter>
                <action android:name="androidx.health.platform.client.ACTION_BIND_SDK_SERVICE" />
            </intent-filter>
        </service>

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="com.dailyroutine.app.androidx-startup"
            android:exported="false" >
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.lifecycle.ProcessLifecycleInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.profileinstaller.ProfileInstallerInitializer"
                android:value="androidx.startup" />
        </provider>

        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            android:directBootAware="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP" >
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.INSTALL_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SKIP_FILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SAVE_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.BENCHMARK_OPERATION" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
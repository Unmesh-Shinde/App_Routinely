<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bgPage">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/m3_premium_surface"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Settings"
            app:titleTextColor="@color/textPrimary"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:navigationIconTint="@color/textPrimary" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/settingsScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="32dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/surfaceProfile"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/badgeProfile"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Display preferences"
                        android:textColor="@color/textPrimary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Choose the visual theme that Routinely should use across the app."
                        android:textColor="@color/textSecondary"
                        android:textSize="13sp" />

                    <RadioGroup
                        android:id="@+id/radioGroupTheme"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical">

                        <RadioButton
                            android:id="@+id/radioThemeSystem"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Use device theme"
                            android:textColor="@color/textPrimary" />

                        <RadioButton
                            android:id="@+id/radioThemeLight"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Light mode"
                            android:textColor="@color/textPrimary" />

                        <RadioButton
                            android:id="@+id/radioThemeDark"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Dark mode"
                            android:textColor="@color/textPrimary" />
                    </RadioGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/surfaceProfile"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/badgeProfile"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="App Lock"
                                android:textColor="@color/textPrimary"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvLockSummary"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Off"
                                android:textColor="@color/textSecondary"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchAppLock"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <TextView
                        style="@style/LabelText"
                        android:layout_marginTop="18dp"
                        android:text="Lock timing" />

                    <RadioGroup
                        android:id="@+id/radioGroupLockTimeout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical">

                        <RadioButton
                            android:id="@+id/radioLockExit"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Immediately after leaving"
                            android:textColor="@color/textPrimary" />

                        <RadioButton
                            android:id="@+id/radioLock10"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="After 10 minutes away"
                            android:textColor="@color/textPrimary" />

                        <RadioButton
                            android:id="@+id/radioLock30"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="After 30 minutes away"
                            android:textColor="@color/textPrimary" />

                        <RadioButton
                            android:id="@+id/radioLock60"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="After 60 minutes away"
                            android:textColor="@color/textPrimary" />
                    </RadioGroup>

                    <TextView
                        style="@style/LabelText"
                        android:layout_marginTop="18dp"
                        android:text="Unlock method" />

                    <RadioGroup
                        android:id="@+id/radioGroupUnlockMethod"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical">

                        <RadioButton
                            android:id="@+id/radioUnlockPin"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Six digit PIN"
                            android:textColor="@color/textPrimary" />

                        <RadioButton
                            android:id="@+id/radioUnlockBiometric"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Fingerprint or face unlock"
                            android:textColor="@color/textPrimary" />
                    </RadioGroup>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnChangePin"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="14dp"
                        android:text="Create PIN"
                        android:textColor="@color/healthProfile"
                        android:textAllCaps="false"
                        android:textStyle="bold"
                        app:cornerRadius="14dp"
                        app:iconTint="@color/healthProfile"
                        app:strokeColor="@color/healthProfile" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:lineSpacingMultiplier="1.2"
                        android:text="Biometric unlock uses credentials enrolled on this device. Routinely does not store biometric data."
                        android:textColor="@color/textSecondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/surfaceProfile"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/badgeProfile"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Advanced Options"
                        android:textColor="@color/textPrimary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Manage your local data and AI calorie cache."
                        android:textColor="@color/textSecondary"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnClearLoggedLists"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="14dp"
                        android:text="Clear Logged Lists..."
                        android:textColor="@android:color/holo_red_dark"
                        android:textAllCaps="false"
                        android:textStyle="bold"
                        app:cornerRadius="14dp"
                        app:iconTint="@android:color/holo_red_dark"
                        app:strokeColor="@android:color/holo_red_dark" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnClearDataAndCache"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="10dp"
                        android:text="Clear Lists &amp; AI Cache..."
                        android:textColor="@android:color/holo_red_dark"
                        android:textAllCaps="false"
                        android:textStyle="bold"
                        app:cornerRadius="14dp"
                        app:iconTint="@android:color/holo_red_dark"
                        app:strokeColor="@android:color/holo_red_dark" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
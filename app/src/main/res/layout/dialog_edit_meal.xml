<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="14dp">

        <ImageView
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_circle_diet"
            android:contentDescription="Meal"
            android:padding="11dp"
            app:srcCompat="@drawable/ic_meal" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Meal details"
                android:textColor="@color/textPrimary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Name it, time it, and optionally set a reminder."
                android:textColor="@color/textSecondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardMealGuidance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#0D4CAF50"
        app:strokeColor="#334CAF50"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="top">

            <ImageView
                android:id="@+id/ivMealGuidanceIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="1dp"
                android:layout_marginEnd="10dp"
                android:contentDescription="Notice"
                app:srcCompat="@android:drawable/ic_dialog_info"
                app:tint="@color/healthNutrition" />

            <TextView
                android:id="@+id/tvMealGuidance"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Meal plan limit: Up to two active meals per category (Breakfast, Lunch, Dinner, Snack) on each date. Gemini request allowances are separate.\n\nPlease enter the meal title and details carefully without spelling or grammatical errors. The text is used directly to calculate calories and nutrients, so clear and accurate descriptions produce the best results."
                android:textColor="@color/textSecondary"
                android:textSize="13sp"
                android:lineSpacingExtra="2.5dp"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        style="@style/LabelText"
        android:text="Meal Name"/>

    <EditText
        android:id="@+id/etMealName"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="6dp"
        android:hint="e.g. Greek Yogurt with Nuts"
        android:background="@drawable/bg_field"
        android:paddingHorizontal="12dp"
        android:inputType="textCapSentences"/>

    <TextView
        style="@style/LabelText"
        android:layout_marginTop="18dp"
        android:text="Meal Category"/>

    <Spinner
        android:id="@+id/spinnerMealType"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_field"/>

    <TextView
        style="@style/LabelText"
        android:layout_marginTop="18dp"
        android:text="Meal description"/>

    <EditText
        android:id="@+id/etMealNotes"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginTop="6dp"
        android:hint="Describe the meal in detail"
        android:gravity="top"
        android:background="@drawable/bg_field"
        android:padding="12dp"
        android:inputType="textMultiLine|textCapSentences"/>

    <TextView
        android:id="@+id/tvMealPercentLimitWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Percent signs are limited to 5 per description."
        android:textColor="@color/textSecondary"
        android:textSize="12sp"
        android:visibility="gone"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="18dp">

        <TextView
            android:id="@+id/tvMealTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="08:00"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/healthNutrition"/>

        <Button
            android:id="@+id/btnPickMealTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Time"
            android:backgroundTint="@color/healthNutrition"
            android:textColor="@android:color/white"/>
    </LinearLayout>

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/swMealReminder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Set Reminder"
        android:checked="true"/>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_shell"
    android:padding="4dp">

    <!-- Water Section (Pinned to bottom with absolute horizontal symmetry) -->
    <RelativeLayout
        android:id="@+id/llWaterSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@drawable/bg_widget_metric"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp">

        <!-- Controls container: Forces the [-] Value [+] to be exactly centered -->
        <LinearLayout
            android:id="@+id/llWaterControls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/btnWidgetRemoveWater"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/bg_widget_action"
                android:gravity="center">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_remove_water"
                    android:textColor="@color/strokeHydration"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvWidgetWater"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:text="0.0 L"
                android:textColor="@color/textPrimary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/btnWidgetAddWater"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/bg_widget_action"
                android:gravity="center">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_add_water"
                    android:textColor="@color/strokeHydration"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Icon: Positioned relative to the centered controls so it doesn't push them right -->
        <ImageView
            android:id="@+id/ivWidgetWaterIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_centerVertical="true"
            android:layout_toLeftOf="@id/llWaterControls"
            android:layout_marginRight="10dp"
            android:src="@drawable/ic_water"
            android:contentDescription="@string/widget_water_label" />
    </RelativeLayout>

    <!-- Hero Circular Progress Section (Centered in remaining space) -->
    <FrameLayout
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_centerHorizontal="true"
        android:layout_alignParentTop="true"
        android:layout_marginTop="0dp"
        android:layout_above="@id/llWaterSection">

        <ProgressBar
            android:id="@+id/pbWidgetSteps"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:indeterminate="false"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/bg_widget_progress_circle" />

        <LinearLayout
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="0dp">

            <ImageView
                android:id="@+id/ivWidgetStepsIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_steps"
                android:contentDescription="@string/widget_steps_label" />

            <TextView
                android:id="@+id/tvWidgetSteps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/textPrimary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvWidgetStepProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="/ 10,000"
                android:textColor="@color/textSecondary"
                android:textSize="10sp" />

            <LinearLayout
                android:layout_width="40dp"
                android:layout_height="1dp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp"
                android:background="#D1D5DB"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/tvWidgetDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.0 km"
                android:textColor="@color/strokeWalking"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

</RelativeLayout>

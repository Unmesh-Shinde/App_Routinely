<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_shell"
    android:padding="4dp">

    <RelativeLayout
        android:id="@+id/llWaterSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@drawable/bg_widget_metric"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp">

        <LinearLayout
            android:id="@+id/llWaterControls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/btnWidgetRemoveWater"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/bg_widget_action"
                android:gravity="center">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_remove_water"
                    android:textColor="@color/strokeHydration"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvWidgetWater"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:text="0.0 L"
                android:textColor="@color/textPrimary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/btnWidgetAddWater"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/bg_widget_action"
                android:gravity="center">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_add_water"
                    android:textColor="@color/strokeHydration"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/ivWidgetWaterIcon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_centerVertical="true"
            android:layout_toLeftOf="@id/llWaterControls"
            android:layout_marginRight="6dp"
            android:src="@drawable/ic_water"
            android:contentDescription="@string/widget_water_label" />
    </RelativeLayout>

    <FrameLayout
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:layout_centerHorizontal="true"
        android:layout_alignParentTop="true"
        android:layout_above="@id/llWaterSection">

        <ProgressBar
            android:id="@+id/pbWidgetSteps"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:indeterminate="false"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/bg_widget_progress_circle_compact" />

        <LinearLayout
            android:layout_width="66dp"
            android:layout_height="66dp"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/ivWidgetStepsIcon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_steps"
                android:contentDescription="@string/widget_steps_label" />
            <TextView
                android:id="@+id/tvWidgetSteps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/textPrimary"
                android:textSize="16sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tvWidgetStepProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="/ 10,000"
                android:textColor="@color/textSecondary"
                android:textSize="8sp" />
            <View
                android:layout_width="28dp"
                android:layout_height="1dp"
                android:layout_marginTop="1dp"
                android:layout_marginBottom="1dp"
                android:background="#D1D5DB" />
            <TextView
                android:id="@+id/tvWidgetDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.0 km"
                android:textColor="@color/strokeWalking"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>
</RelativeLayout>

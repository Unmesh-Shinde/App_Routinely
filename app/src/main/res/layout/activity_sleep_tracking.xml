<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bgPage">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/healthSleep"
        android:paddingTop="64dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Sleep Tracker"
            app:titleTextColor="@android:color/white"/>

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayoutSleep"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/healthSleep"
            app:tabTextColor="#B3E5FC"
            app:tabSelectedTextColor="@android:color/white"
            app:tabIndicatorColor="@android:color/white"
            app:tabMode="fixed"
            android:visibility="gone">
            <com.google.android.material.tabs.TabItem android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Weekly"/>
            <com.google.android.material.tabs.TabItem android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Monthly"/>
        </com.google.android.material.tabs.TabLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:id="@+id/sleepContentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="80dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Initial Connect State -->
        <LinearLayout
            android:id="@+id/llConnectApp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="visible">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="😴" android:textSize="64sp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Connect an App to view your Sleep data"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/textPrimary"
                android:gravity="center"/>

            <TextView
                android:id="@+id/tvFoundApps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Searching for fitness apps on your device..."
                android:textSize="14sp"
                android:textColor="@color/textSecondary"
                android:gravity="center"/>

            <LinearLayout
                android:id="@+id/llAppList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="32dp"/>

            <ProgressBar
                android:id="@+id/pbSyncing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:visibility="gone"/>
            <TextView
                android:id="@+id/tvSyncing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Syncing Data..."
                android:textSize="14sp"
                android:textStyle="italic"
                android:visibility="gone"/>
        </LinearLayout>

        <!-- Analytics Dashboard (Weekly/Monthly) -->
        <LinearLayout
            android:id="@+id/llSleepAnalytics"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <!-- Weekly Tab View -->
                <LinearLayout
                    android:id="@+id/viewWeeklySleep"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="320dp"
                        android:scrollbars="none">
                        <RelativeLayout
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent">

                            <!-- Reference Marks (Y-Axis) - Extended width to ensure they span across scrolls -->
                            <View android:layout_width="2000dp" android:layout_height="1dp" android:background="#26000000" android:layout_marginTop="70dp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="10h" android:textSize="10sp" android:textStyle="bold" android:textColor="#80000000" android:layout_marginTop="56dp" android:paddingStart="4dp"/>

                            <View android:layout_width="2000dp" android:layout_height="2dp" android:background="#805C6BC0" android:layout_marginTop="120dp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Goal: 8h" android:textSize="10sp" android:textStyle="bold" android:textColor="#5C6BC0" android:layout_marginTop="106dp" android:paddingStart="4dp"/>

                            <View android:layout_width="2000dp" android:layout_height="1dp" android:background="#26000000" android:layout_marginTop="170dp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="6h" android:textSize="10sp" android:textStyle="bold" android:textColor="#80000000" android:layout_marginTop="156dp" android:paddingStart="4dp"/>

                            <LinearLayout
                                android:id="@+id/llWeeklySleepGraph"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:orientation="horizontal"
                                android:padding="16dp"
                                android:gravity="bottom"/>
                        </RelativeLayout>
                    </HorizontalScrollView>

                    <TextView
                        android:id="@+id/tvWeeklySleepWarning"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:text="⚠️ Sleep deficit detected..."
                        android:textColor="#E65100"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:background="#FFF3E0"
                        android:layout_margin="16dp"
                        android:visibility="gone"/>
                </LinearLayout>

                <!-- Monthly Tab View -->
                <LinearLayout
                    android:id="@+id/viewMonthlySleep"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="320dp"
                        android:scrollbars="none">
                        <RelativeLayout
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent">

                            <!-- Monthly Reference Marks -->
                            <View android:layout_width="2000dp" android:layout_height="1dp" android:background="#26000000" android:layout_marginTop="70dp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="62h" android:textSize="10sp" android:textStyle="bold" android:textColor="#80000000" android:layout_marginTop="56dp" android:paddingStart="4dp"/>

                            <View android:layout_width="2000dp" android:layout_height="2dp" android:background="#805C6BC0" android:layout_marginTop="120dp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Goal: 56h" android:textSize="10sp" android:textStyle="bold" android:textColor="#5C6BC0" android:layout_marginTop="106dp" android:paddingStart="4dp"/>

                            <View android:layout_width="2000dp" android:layout_height="1dp" android:background="#26000000" android:layout_marginTop="170dp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="50h" android:textSize="10sp" android:textStyle="bold" android:textColor="#80000000" android:layout_marginTop="156dp" android:paddingStart="4dp"/>

                            <LinearLayout
                                android:id="@+id/llMonthlySleepGraph"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:orientation="horizontal"
                                android:padding="16dp"
                                android:gravity="bottom"/>
                        </RelativeLayout>
                    </HorizontalScrollView>

                    <TextView
                        android:id="@+id/tvMonthlySleepWarning"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:text="⚠️ Sleep target not met in..."
                        android:textColor="#E65100"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:background="#FFF3E0"
                        android:layout_margin="16dp"
                        android:visibility="gone"/>
                </LinearLayout>

            </FrameLayout>
        </LinearLayout>

    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>

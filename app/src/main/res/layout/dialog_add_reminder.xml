<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp">

        <!-- ── Category ── -->
        <TextView
            style="@style/LabelText"
            android:text="Category"/>

        <Spinner
            android:id="@+id/spinnerType"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_field"/>

        <!-- ── Title ── -->
        <TextView
            style="@style/LabelText"
            android:layout_marginTop="18dp"
            android:text="Title"/>

        <EditText
            android:id="@+id/etTitle"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:hint="Enter reminder title"
            android:inputType="textCapSentences"
            android:background="@drawable/bg_field"
            android:paddingHorizontal="12dp"/>

        <!-- ── Meal Specific Fields ── -->
        <LinearLayout
            android:id="@+id/llMealDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/LabelText"
                android:layout_marginTop="18dp"
                android:text="Dish Type"/>

            <EditText
                android:id="@+id/etDishType"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:hint="e.g. Pasta, Salad, etc."
                android:inputType="textCapSentences"
                android:background="@drawable/bg_field"
                android:paddingHorizontal="12dp"/>

            <TextView
                style="@style/LabelText"
                android:layout_marginTop="18dp"
                android:text="Ingredients"/>

            <EditText
                android:id="@+id/etIngredients"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginTop="6dp"
                android:hint="e.g. Spinach, Tomato, Tofu"
                android:inputType="textMultiLine|textCapSentences"
                android:gravity="top"
                android:background="@drawable/bg_field"
                android:padding="12dp"/>
        </LinearLayout>

        <!-- ── Mode ── -->
        <TextView
            style="@style/LabelText"
            android:layout_marginTop="18dp"
            android:text="Reminder Mode"/>

        <RadioGroup
            android:id="@+id/rgMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <RadioButton
                android:id="@+id/rbFixedTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Fixed Time"
                android:checked="true"
                android:buttonTint="@color/primary"/>

            <RadioButton
                android:id="@+id/rbInterval"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Interval"
                android:buttonTint="@color/primary"/>
        </RadioGroup>

        <!-- ── Fixed time section ── -->
        <LinearLayout
            android:id="@+id/llFixed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp">

            <TextView
                android:id="@+id/tvTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="08:00"
                android:textSize="36sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:gravity="center"/>

            <Button
                android:id="@+id/btnPickTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Change"
                android:backgroundTint="@color/primary"
                android:textColor="@android:color/white"/>
        </LinearLayout>

        <!-- ── Interval section ── -->
        <LinearLayout
            android:id="@+id/llInterval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Every"
                android:textColor="@color/textPrimary"
                android:textSize="15sp"/>

            <EditText
                android:id="@+id/etIntervalMin"
                android:layout_width="72dp"
                android:layout_height="50dp"
                android:layout_marginHorizontal="10dp"
                android:text="60"
                android:inputType="number"
                android:gravity="center"
                android:textStyle="bold"
                android:textSize="18sp"
                android:background="@drawable/bg_field"
                android:textColor="@color/primary"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="minutes"
                android:textColor="@color/textPrimary"
                android:textSize="15sp"/>
        </LinearLayout>

        <!-- ── Frequency Selection ── -->
        <TextView
            style="@style/LabelText"
            android:layout_marginTop="18dp"
            android:text="Frequency"/>

        <Spinner
            android:id="@+id/spinnerFrequency"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_field"/>

        <!-- ── Repeat days ── -->
        <LinearLayout
            android:id="@+id/llRepeatDays"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                style="@style/LabelText"
                android:layout_marginTop="18dp"
                android:text="Repeat On"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp"
                android:gravity="center">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="M" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/textSecondary"/>
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/swMon" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:checked="true" android:showText="false"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="T" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/textSecondary"/>
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/swTue" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:checked="true" android:showText="false"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="W" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/textSecondary"/>
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/swWed" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:checked="true" android:showText="false"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="T" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/textSecondary"/>
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/swThu" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:checked="true" android:showText="false"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="F" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/textSecondary"/>
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/swFri" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:checked="true" android:showText="false"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="S" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/textSecondary"
                        android:alpha="0.7"/>
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/swSat" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:checked="true" android:showText="false"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="S" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/textSecondary"
                        android:alpha="0.7"/>
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/swSun" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:checked="true" android:showText="false"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ── Monthly Day section ── -->
        <LinearLayout
            android:id="@+id/llMonthlyDay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="18dp"
            android:visibility="gone">
            <TextView
                style="@style/LabelText"
                android:text="Day of Month: "/>
            <EditText
                android:id="@+id/etDayOfMonth"
                android:layout_width="60dp"
                android:layout_height="50dp"
                android:layout_marginStart="10dp"
                android:text="1"
                android:inputType="number"
                android:gravity="center"
                android:background="@drawable/bg_field"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- ── Notification Tone ── -->
        <TextView
            style="@style/LabelText"
            android:layout_marginTop="24dp"
            android:text="Notification Tone"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvToneName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Default"
                android:textColor="@color/textPrimary"
                android:textSize="14sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:paddingHorizontal="12dp"
                android:paddingVertical="14dp"
                android:background="@drawable/bg_field"/>

            <ImageButton
                android:id="@+id/btnPickTone"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:src="@android:drawable/ic_menu_agenda"
                android:background="@drawable/bg_circle_diet"
                android:backgroundTint="@color/primary"
                android:padding="10dp"
                app:tint="@android:color/white"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>

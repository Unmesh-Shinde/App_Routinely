<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="76dp"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="bottom|center_horizontal"
    android:paddingHorizontal="3dp"
    android:paddingVertical="2dp">

    <!-- Value labels container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/tvStepValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/healthWalking"
            android:maxLines="1"
            android:includeFontPadding="false"
            tools:text="10.5k"/>

        <TextView
            android:id="@+id/tvHeartValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/healthCalories"
            android:maxLines="1"
            android:includeFontPadding="false"
            tools:text="45"/>
    </LinearLayout>

    <!-- Side-by-side bars -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:layout_gravity="center_horizontal">

        <View
            android:id="@+id/viewStepBar"
            android:layout_width="15dp"
            android:layout_height="0dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/bg_step_bar" />

        <View
            android:id="@+id/viewHeartBar"
            android:layout_width="15dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_calorie_bar" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvBarLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="@color/textPrimary"
        android:layout_marginTop="6dp"
        android:maxLines="1"
        android:includeFontPadding="false"
        tools:text="Mon"/>

    <TextView
        android:id="@+id/tvBarDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textColor="@color/textSecondary"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:includeFontPadding="false"
        tools:text="12 Oct"/>

</LinearLayout>

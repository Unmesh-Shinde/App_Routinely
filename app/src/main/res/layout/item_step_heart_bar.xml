<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="76dp"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="bottom|center_horizontal"
    android:paddingHorizontal="3dp"
    android:paddingVertical="2dp">

    <!-- Value labels container -->
    <LinearLayout
        android:id="@+id/llTopLabels"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/tvStepValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/healthWalking"
            android:maxLines="1"
            android:includeFontPadding="false"
            tools:text="10.5k"/>

        <TextView
            android:id="@+id/tvHeartValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/healthCalories"
            android:maxLines="1"
            android:includeFontPadding="false"
            tools:text="45"/>
    </LinearLayout>

    <!-- Side-by-side bars -->
    <FrameLayout
        android:id="@+id/barAreaContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/tvEmptyError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="NO DATA"
            android:textSize="9sp"
            android:textStyle="bold"
            android:textColor="@color/textSecondary"
            android:rotation="-90"
            android:visibility="gone"/>

        <LinearLayout
            android:id="@+id/llBarContainer"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="bottom"
            android:layout_gravity="center_horizontal">

            <View
                android:id="@+id/viewStepBar"
                android:layout_width="15dp"
                android:layout_height="0dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/bg_step_bar" />

            <LinearLayout
                android:id="@+id/viewHeartBar"
                android:layout_width="15dp"
                android:layout_height="0dp"
                android:orientation="vertical"
                android:gravity="bottom"
                android:background="@drawable/bg_calorie_bar">
                <View
                    android:id="@+id/viewBurnedActive"
                    android:layout_width="match_parent"
                    android:layout_height="0dp" />
                <View
                    android:id="@+id/viewBurnedBmr"
                    android:layout_width="match_parent"
                    android:layout_height="0dp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/tvBarLabel"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="@color/textPrimary"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:maxLines="1"
        android:includeFontPadding="false"
        tools:text="Mon"/>

    <TextView
        android:id="@+id/tvBarDate"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:textSize="11sp"
        android:textColor="@color/textSecondary"
        android:layout_marginTop="0dp"
        android:gravity="center"
        android:maxLines="1"
        android:includeFontPadding="false"
        tools:text="12 Oct"/>

</LinearLayout>

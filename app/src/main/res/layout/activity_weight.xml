<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bgPage">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/m3_premium_surface"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Weight Tracker"
            app:titleTextColor="@color/textPrimary"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:navigationIconTint="@color/textPrimary"/>

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayoutWeight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/m3_premium_surface"
            app:tabTextColor="@color/textSecondary"
            app:tabSelectedTextColor="@color/primary"
            app:tabIndicatorColor="@color/primary"
            app:tabMode="fixed">
            <com.google.android.material.tabs.TabItem android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Today"/>
            <com.google.android.material.tabs.TabItem android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Weekly"/>
            <com.google.android.material.tabs.TabItem android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Monthly"/>
        </com.google.android.material.tabs.TabLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:id="@+id/weightContentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="24dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Today View -->
        <LinearLayout
            android:id="@+id/viewTodayWeight"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="top|center_horizontal"
            android:paddingHorizontal="32dp"
            android:paddingTop="16dp"
            android:paddingBottom="32dp"
            android:visibility="visible">

            <TextView
                android:id="@+id/tvIdealWeightMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="0dp"
                android:background="@color/m3_premium_container"
                android:gravity="center"
                android:padding="12dp"
                android:text="Ideal weight will appear after profile setup."
                android:textColor="@color/healthWeight"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageView android:layout_width="72dp" android:layout_height="72dp" android:contentDescription="Weight" android:padding="10dp" app:srcCompat="@drawable/ic_weight" app:tint="@color/healthWeight"/>
            <TextView android:id="@+id/tvCurrentWeight" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.0 kg" android:textSize="32sp" android:textStyle="bold" android:textColor="@color/textPrimary" android:layout_marginTop="16dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogWeight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Log Today's Weight"
                app:cornerRadius="24dp"
                android:backgroundTint="@color/healthWeight"/>

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- Weekly View -->
        <LinearLayout
            android:id="@+id/viewWeeklyWeight"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="320dp">
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scrollbars="none">
                    <LinearLayout
                        android:id="@+id/llWeeklyWeightGraph"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:gravity="bottom"/>
                </HorizontalScrollView>
                <com.dailyroutine.app.GoalLineOverlayView
                    android:id="@+id/weeklyWeightGoalOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="250dp"
                    android:layout_gravity="bottom"
                    android:layout_marginBottom="40dp" />
            </FrameLayout>
        </LinearLayout>

        <!-- Monthly View -->
        <LinearLayout
            android:id="@+id/viewMonthlyWeight"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvMonthlyWeight"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
        </LinearLayout>

    </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
